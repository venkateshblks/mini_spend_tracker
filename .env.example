# Copy to .env. Never commit real credentials.
# Supabase: Connect > Session pooler > URI; replace the password placeholder.
# URL-encode special characters in the password. Keep sslmode=require.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Tests use a SEPARATE local/disposable PostgreSQL database, not your Supabase project.
# TEST_DATABASE_URL=postgresql://spend:spend_local_only@127.0.0.1:5433/spend_tracker_test
